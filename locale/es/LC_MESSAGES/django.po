#: .\institucional\templates\components\_privacy_terms.html:27
msgid ""
"\n"
"                    Podemos coletar dados fornecidos por você (ex.: nome, "
"telefone, e-mail, mensagem) ao preencher\n"
"                    formulários,\n"
"                    entrar em contato via WhatsApp ou agendar atendimento. "
"Também podemos coletar dados técnicos de\n"
"                    navegação\n"
"                    (ex.: IP, dispositivo e páginas visitadas) para fins de "
"segurança e estatística.\n"
"                    "
msgstr "\n""                    Podemos coletar dados fornecidos por você (ex.: nome, ""telefone, e-mail, mensagem) ao preencher\n""                    formulários,\n""                    entrar em contato via WhatsApp ou agendar atendimento. ""Também podemos coletar dados técnicos de\n""                    navegação\n""                    (ex.: IP, dispositivo e páginas visitadas) para fins de ""segurança e estatística.\n""                    "
"\n"
"                    Podemos recopilar los datos que nos proporcionas (p. "
"ej.: nombre, teléfono, correo, mensaje) al completar\n"
"                    formularios,\n"
"                    contactar por WhatsApp o agendar una atención. También "
"podemos recopilar datos técnicos de\n"
"                    navegación\n"
"                    (p. ej.: IP, dispositivo y páginas visitadas) con fines "
"de seguridad y estadística.\n"
"                    "

